{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Bridg",
  "description": "Bridg prices a cross-chain transfer across every bridge that serves it, ranks the results by what lands, and returns the transaction you sign.",
  "colors": {
    "primary": "#7fb800",
    "light": "#c8f542",
    "dark": "#7fb800"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://bridg.now"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "light": "#fafafa",
      "dark": "#0a0a0b"
    }
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk"
    },
    "body": {
      "family": "Inter"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Open Bridg",
        "href": "https://bridg.now"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get a quote",
      "href": "/api-reference/quote/quote"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "how-it-works",
              "quickstart",
              "sdk"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/typescript-setup",
              "guides/bridge-tokens",
              "guides/swap-across-chains",
              "guides/deposit-to-hyperliquid",
              "guides/bridge-privately",
              "guides/earn-referral-fees",
              "guides/track-a-transfer"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/ranking",
              "concepts/fees",
              "concepts/referrals",
              "concepts/privacy",
              "concepts/hyperliquid"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/chains",
              "reference/venues",
              "reference/errors",
              "reference/faq"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/overview",
              "api-reference/rate-limits"
            ]
          },
          {
            "group": "Markets",
            "pages": [
              "api-reference/markets/source-chains",
              "api-reference/markets/routes",
              "api-reference/markets/venues"
            ]
          },
          {
            "group": "Transfers",
            "pages": [
              "api-reference/quote/quote",
              "api-reference/quote/build",
              "api-reference/quote/submit",
              "api-reference/quote/transfer"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://bridg.now"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "chatgpt",
      "claude",
      "perplexity",
      "grok",
      "aistudio",
      "devin",
      "devin-desktop",
      "mcp",
      "add-mcp",
      "cursor",
      "vscode",
      "devin-mcp",
      "download-spec"
    ],
    "display": "header"
  }
}
